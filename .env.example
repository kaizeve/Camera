# Copie para .env (chmod 600) e preencha. NUNCA versione o .env.

# Versão fixa do Frigate (não use latest)
FRIGATE_VERSION=0.17.1

# IP Tailscale desta VPS (tailscale ip -4). As portas só escutam nele.
TAILSCALE_IP=

# Câmera (alcançável via subnet router Tailscale de casa)
FRIGATE_CAM_HOST=192.168.18.17
FRIGATE_CAM_USER=
FRIGATE_CAM_PASSWORD=
